menu "Components"

config OPENEMBER_ENABLE_CRYPTO
  bool "Build ember_crypto (CRC/MD5/SHA256)"
  default y

config OPENEMBER_ENABLE_LOGGING
  bool "Build ember_logging (builtin stderr logger)"
  default y
  help
    Lightweight C logging API (ember/log.h). No spdlog dependency.

config OPENEMBER_ENABLE_COMMON
  bool "Build ember_common (hello/random/time helpers)"
  default y
  help
    Small C utility helpers migrated from OpenEmber components/Common.

config OPENEMBER_ENABLE_NETDEV
  bool "Build ember_netdev (Linux net interface helpers)"
  default y
  depends on OPENEMBER_ENABLE_LOGGING
  help
    C API for MAC/IP/netmask/gateway/DNS/link status via ioctl/ethtool
    (migrated from OpenEmber components/Common/netdev).

config OPENEMBER_ENABLE_PPOOL
  bool "Build ember_ppool (pthread thread pool)"
  default y
  help
    Fixed-size pthread thread pool with priority task queue (C API).

endmenu
